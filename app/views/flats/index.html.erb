<%= render "flats/nav" %>

<div class="container mt-3">
  <div class="row">
    <div class="col-12">
      <h1>All our Flats (<%= @flats.count %>)</h1>
    </div>
  </div>
  <hr>

  <div class="container mt-4">
    <div class="row">
      <% @flats.each do |flat| %>
        <%= render "flats/flat", flat: flat %>
      <% end %>
    </div>
  </div>

</div>
