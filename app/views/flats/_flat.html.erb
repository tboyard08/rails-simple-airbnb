
<div class="col-md-4 mb-4">

  <div class="flat-card h-100">

    <!-- Flat information -->
    <div class="flat-card-content">

      <div class="flat-card-title">
        <h4><%= flat.name %></h4>
      </div>

      <p><%= flat.address %></p>

      <div class="d-flex align-items-center gap-4">

        <div>
          <b>Number of guests:</b>
          <span class="ms-2"><%= flat.number_of_guests %></span>
        </div>

        <div>
          <b>Price per night:</b>
          <span class="ms-2"><%= flat.price_per_night %></span>
        </div>

      </div>

    </div>

    <!-- Actions -->
    <div class="flat-card-actions">

      <%= link_to "More info", flat_path(flat) %>

      <%= link_to "Edit", edit_flat_path(flat),
          class: "text-warning" %>

      <%= link_to "Remove", flat_path(flat),
          data: {
            turbo_method: :delete,
            turbo_confirm: "Are you sure?"
          },
          class: "text-danger" %>

    </div>

  </div>

</div>
